# Copia come .env (non committare questo file)
OPENAI_API_KEY=
# Modello Responses API compatibile con JSON Schema
OPENAI_MODEL=gpt-5.4-mini
HOST=127.0.0.1
PORT=8787
# Obbligatorio se esponi il servizio sulla LAN / Internet
COACH_ACCESS_TOKEN=
# Aggiungi l'origine GitHub Pages se distribuisci il frontend (es: https://utente.github.io)
ALLOWED_ORIGINS=
